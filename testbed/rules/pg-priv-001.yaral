rule pg_priv_001_privilege_grant_to_role {

  meta:
    author         = "thesis-lab"
    description    = "Privilege grant to self or lateral role grant: a GRANT statement conferring privileges on another role, captured to surface self-granted or lateral privilege escalation inside the procurement database."
    rule_id        = "PG-PRIV-001"
    rule_name      = "Privilege grant to self or lateral role grant"
    scenario_class = "S2"
    severity       = "Critical"
    mitre_attack   = "T1078.004"
    data_source    = "Teleport db.session.query, log type TELEPORT_ACCESS_PLANE, product TELEPORT_DB_AUDIT"

  events:
    // source scoping, verified against live TELEPORT_ACCESS_PLANE events (custom parser)
    $e.metadata.log_type           = "TELEPORT_ACCESS_PLANE"
    $e.metadata.product_name       = "TELEPORT_DB_AUDIT"
    $e.metadata.vendor_name        = "TELEPORT"
    $e.metadata.event_type         = "USER_RESOURCE_ACCESS"
    $e.metadata.product_event_type = "db.session.query"

    // statement text matches ^\s*grant\b ... \bto\b
    re.regex($e.security_result.description, `(?i)^\s*grant\b.*\bto\b`)

  condition:
    $e
}
