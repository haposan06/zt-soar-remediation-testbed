rule pg_priv_003_shadow_role_or_default_privileges {

  meta:
    author         = "thesis-lab"
    description    = "Shadow role creation or default privilege alteration: a CREATE ROLE or ALTER DEFAULT PRIVILEGES statement, either of which can establish persistent unauthorised access to procurement data."
    rule_id        = "PG-PRIV-003"
    rule_name      = "Shadow role creation or default privilege alteration"
    scenario_class = "S2"
    severity       = "High"
    mitre_attack   = "T1136.001, T1098"
    data_source    = "Teleport db.session.query, log type TELEPORT_ACCESS_PLANE, product TELEPORT_DB_AUDIT"

  events:
    // source scoping, verified against live TELEPORT_ACCESS_PLANE events (custom parser)
    $e.metadata.log_type           = "TELEPORT_ACCESS_PLANE"
    $e.metadata.product_name       = "TELEPORT_DB_AUDIT"
    $e.metadata.vendor_name        = "TELEPORT"
    $e.metadata.event_type         = "USER_RESOURCE_ACCESS"
    $e.metadata.product_event_type = "db.session.query"

    // statement text matches ^\s*(create role|alter default privileges)\b
    re.regex($e.security_result.description, `(?i)^\s*(create\s+role|alter\s+default\s+privileges)\b`)

  condition:
    $e
}
