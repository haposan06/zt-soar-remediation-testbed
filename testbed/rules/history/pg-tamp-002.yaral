rule pg_tamp_002_truncate_or_drop_commercial_table {

  meta:
    author         = "thesis-lab"
    description    = "TRUNCATE or DROP of a commercial table: a TRUNCATE or DROP TABLE statement whose text references one of the commercial procurement tables, destroying tender, bid, contract, payment or vendor records."
    rule_id        = "PG-TAMP-002"
    rule_name      = "TRUNCATE or DROP of a commercial table"
    scenario_class = "S3"
    severity       = "Critical"
    mitre_attack   = "T1485"
    data_source    = "Teleport db.session.query (TELEPORT_DB_AUDIT)"

  events:
    $e.metadata.event_type   = "GENERIC_EVENT"
    $e.metadata.product_name = "Teleport"
    $e.metadata.vendor_name  = "Gravitational"
    $e.metadata.log_type     = "TELEPORT_DB_AUDIT"

    // db_query matches ^\s*(truncate|drop table)\b
    re.regex($e.target.resource.attribute.labels["db_query"], `(?i)^\s*(truncate|drop\s+table)\b`)

    // db_query matches the commercial-table regex
    re.regex($e.target.resource.attribute.labels["db_query"], `(?i)(tenders|bids|contracts|payments|vendors)`)

  condition:
    $e
}
