rule pg_exf_002_bulk_export_copy_to_stdout {

  meta:
    author         = "thesis-lab"
    description    = "Bulk export via COPY TO STDOUT: a COPY ... TO STDOUT statement whose text references one of the sensitive procurement tables, streaming table contents out of the database session."
    rule_id        = "PG-EXF-002"
    rule_name      = "Bulk export via COPY TO STDOUT"
    scenario_class = "S1"
    severity       = "High"
    mitre_attack   = "T1213, T1005"
    data_source    = "Teleport db.session.query, log type TELEPORT_ACCESS_PLANE, product TELEPORT_DB_AUDIT"

  events:
    // source scoping, verified against live TELEPORT_ACCESS_PLANE events (custom parser)
    $e.metadata.log_type           = "TELEPORT_ACCESS_PLANE"
    $e.metadata.product_name       = "TELEPORT_DB_AUDIT"
    $e.metadata.vendor_name        = "TELEPORT"
    $e.metadata.event_type         = "USER_RESOURCE_ACCESS"
    $e.metadata.product_event_type = "db.session.query"

    // statement text matches COPY ... TO STDOUT
    re.regex($e.security_result.description, `(?i)\bcopy\b.*\bto\s+stdout\b`)

    // statement text matches the sensitive-table regex
    re.regex($e.security_result.description, `(?i)(employees|vendors|payments|bids)`)

  condition:
    $e
}
